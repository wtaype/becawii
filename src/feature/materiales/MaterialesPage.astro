---
// src/feature/materiales/MaterialesPage.astro
// 🌟 Feature Materiales & Cuadernillos Oficiales BecaWii 2026
// Conecta con src/semillas/materiales.json · Cero CSS Inline
// Apertura directa en nueva pestaña (target="_blank") · Formato Tabla
import materialesRaw from '../../semillas/materiales.json';
import './materiales.css';

const materiales = materialesRaw;

const totalTodos = materiales.length;
const totalExamenes = materiales.filter(m => m.categoria === 'examenes').length;
const totalLibros = materiales.filter(m => m.categoria === 'libros').length;
const totalNormativa = materiales.filter(m => m.categoria === 'normativa').length;
---

<div class="materiales-container appwii">
  
  <!-- 1. HEADER DEL MÓDULO -->
  <section class="materiales-header-box" aria-label="Biblioteca de Cuadernillos">
    <div class="materiales-badge-pill">
      <i class="fa-solid fa-book-open" aria-hidden="true"></i>
      <span>Módulo de Estudio Activo</span>
    </div>
    <h1 class="materiales-title">
      Biblioteca &amp; Cuadernillos Oficiales
    </h1>
    <p class="materiales-subtitle">
      Cuadernillos oficiales de PRONABEC Beca 18, solucionarios y libros de preparación listos para abrir o descargar.
    </p>
  </section>

  <!-- 2. CONSEJO DE HERMANOS -->
  <section class="materiales-tip-box" aria-label="Consejo de Hermanos">
    <div class="materiales-tip-icon">
      <i class="fa-solid fa-lightbulb" aria-hidden="true"></i>
    </div>
    <div class="materiales-tip-info">
      <span class="materiales-tip-label">Consejo de Hermanos para Clayda</span>
      <p class="materiales-tip-text">
        Lee primero las preguntas para saber qué buscar en los textos largos. ¡Ahorrarás hasta un 40% de tiempo en la prueba!
      </p>
    </div>
  </section>

  <!-- 3. BUSCADOR Y FILTROS POR CATEGORÍA -->
  <section class="materiales-search-box" aria-label="Búsqueda de materiales">
    <i class="fa-solid fa-magnifying-glass materiales-search-icon" aria-hidden="true"></i>
    <input 
      type="search" 
      id="inputBuscarMaterial" 
      class="materiales-search-input" 
      placeholder="Buscar por año, tema, álgebra, textos o palabra clave..." 
      aria-label="Buscar materiales de estudio"
      autocomplete="off"
    />
  </section>

  <!-- CHIPS DE FILTRO -->
  <nav class="materiales-filter-chips" aria-label="Filtrar por categoría">
    <button type="button" class="materiales-chip-btn active" data-categoria="todos">
      <span>Todos</span>
      <span class="materiales-chip-count" id="countTodos">{totalTodos}</span>
    </button>
    <button type="button" class="materiales-chip-btn" data-categoria="examenes">
      <i class="fa-solid fa-file-signature" aria-hidden="true"></i>
      <span>Exámenes Oficiales</span>
      <span class="materiales-chip-count">{totalExamenes}</span>
    </button>
    <button type="button" class="materiales-chip-btn" data-categoria="libros">
      <i class="fa-solid fa-book" aria-hidden="true"></i>
      <span>Libros Prepárate</span>
      <span class="materiales-chip-count">{totalLibros}</span>
    </button>
    <button type="button" class="materiales-chip-btn" data-categoria="normativa">
      <i class="fa-solid fa-gavel" aria-hidden="true"></i>
      <span>Bases &amp; Normativa</span>
      <span class="materiales-chip-count">{totalNormativa}</span>
    </button>
  </nav>

  <!-- 4. TABLA DE DOCUMENTOS PDF (SIN DESCRIPCIONES LARGAS, ABRIR EN NUEVA PESTAÑA Y DESCARGAR) -->
  <section class="materiales-table-card" aria-label="Tabla de Cuadernillos Oficiales">
    <div class="materiales-table-header">
      <div class="mat-th mat-th-doc">
        <i class="fa-solid fa-file-pdf"></i>
        <span>Documento Oficial</span>
      </div>
      <div class="mat-th mat-th-actions">
        <span>Acciones</span>
      </div>
    </div>

    <div class="materiales-table-body" id="tablaMaterialesBody">
      {materiales.map((mat) => {
        const searchBlob = `${mat.titulo} ${mat.subtitulo} ${(mat.temas || []).join(' ')} ${mat.anio} ${mat.categoria}`.toLowerCase();
        const categoriaNombre = mat.categoria === 'examenes' 
          ? 'Examen' 
          : mat.categoria === 'libros' 
          ? 'Libro' 
          : 'Normativa';

        return (
          <div 
            class="materiales-row" 
            data-categoria={mat.categoria}
            data-busqueda={searchBlob}
          >
            <!-- Icono de PDF -->
            <div class="mat-row-icon" title="Archivo PDF">
              <i class="fa-solid fa-file-pdf"></i>
            </div>

            <!-- Título y Metadatos Compactos (Sin descripción) -->
            <div class="mat-row-content">
              <a 
                href={mat.archivoUrl} 
                target="_blank" 
                rel="noopener noreferrer" 
                class="mat-row-title"
                title={`Abrir ${mat.titulo} en una nueva pestaña`}
              >
                {mat.titulo}
              </a>
              <div class="mat-row-meta">
                <span class="mat-badge-cat">{categoriaNombre}</span>
                <span class="mat-meta-detail">
                  <i class="fa-solid fa-calendar"></i> {mat.anio}
                </span>
                <span class="mat-meta-detail">
                  <i class="fa-solid fa-copy"></i> {mat.paginas} pág.
                </span>
                {mat.destacado && (
                  <span class="mat-badge-destacado" title="Material destacado">
                    <i class="fa-solid fa-star"></i>
                  </span>
                )}
              </div>
            </div>

            <!-- Botones de Acción: Abrir (Nueva Pestaña) y Descargar -->
            <div class="mat-row-actions">
              <a 
                href={mat.archivoUrl} 
                target="_blank" 
                rel="noopener noreferrer" 
                class="mat-btn-action btn-open"
                title={`Abrir ${mat.titulo} en nueva pestaña`}
                data-witip="Abrir en nueva pestaña"
              >
                <i class="fa-solid fa-arrow-up-right-from-square"></i>
                <span class="mat-action-text">Abrir</span>
              </a>

              <a 
                href={mat.archivoUrl} 
                download={`${mat.id}.pdf`}
                class="mat-btn-action btn-download"
                title={`Descargar ${mat.titulo}`}
                data-witip="Descargar PDF"
              >
                <i class="fa-solid fa-download"></i>
                <span class="mat-action-text">Descargar</span>
              </a>
            </div>
          </div>
        );
      })}
    </div>

    <!-- Estado Vacío cuando la búsqueda no coincide -->
    <div id="materialesEmpty" class="materiales-empty" role="status" style="display: none;">
      <i class="fa-solid fa-folder-open" aria-hidden="true"></i>
      <p>No se encontraron cuadernillos que coincidan con tu búsqueda.</p>
    </div>
  </section>

</div>

<script is:inline>
  (function() {
    function initMaterialesPage() {
      var categoriaActual = 'todos';
      var textoBusqueda = '';

      var chips = document.querySelectorAll('.materiales-chip-btn');
      var inputBuscar = document.getElementById('inputBuscarMaterial');
      var rows = document.querySelectorAll('.materiales-row');
      var emptyBox = document.getElementById('materialesEmpty');

      function filtrarMateriales() {
        var visibles = 0;
        var q = textoBusqueda.trim().toLowerCase();

        rows.forEach(function(row) {
          var cat = row.getAttribute('data-categoria');
          var blob = row.getAttribute('data-busqueda') || '';

          var coincideCat = (categoriaActual === 'todos' || cat === categoriaActual);
          var coincideTexto = (!q || blob.indexOf(q) !== -1);

          if (coincideCat && coincideTexto) {
            row.style.display = 'flex';
            visibles++;
          } else {
            row.style.display = 'none';
          }
        });

        if (emptyBox) {
          emptyBox.style.display = visibles === 0 ? 'flex' : 'none';
        }
      }

      // Filtro por Chips
      chips.forEach(function(chip) {
        if (!chip.dataset.bound) {
          chip.dataset.bound = 'true';
          chip.addEventListener('click', function() {
            chips.forEach(function(c) { c.classList.remove('active'); });
            chip.classList.add('active');
            categoriaActual = chip.getAttribute('data-categoria') || 'todos';
            filtrarMateriales();
          });
        }
      });

      // Filtro por Buscador en Vivo
      if (inputBuscar && !inputBuscar.dataset.bound) {
        inputBuscar.dataset.bound = 'true';
        inputBuscar.addEventListener('input', function(e) {
          textoBusqueda = e.target.value || '';
          filtrarMateriales();
        });
      }
    }

    document.addEventListener('astro:page-load', initMaterialesPage);
    initMaterialesPage();
  })();
</script>
