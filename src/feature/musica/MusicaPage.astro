---
// src/feature/musica/MusicaPage.astro
// 🎵 Módulo de Música & Concentración Offline para Clayda
// BecaWii 2026 · Conexión directa a public/cloudwii/lista/ · 100% Offline
import playlistData from '../../semillas/playlist.json' with { type: 'json' };
import './musica.css';

const playlistJson = JSON.stringify(playlistData);
---

<div class="musica-container" id="musicaRoot">
  <!-- 1. ENCABEZADO ESPIRITUAL DE PAZ -->
  <section class="musica-hero-card" aria-label="Introducción a la música de concentración">
    <div class="musica-hero-glow-1"></div>
    <div class="musica-hero-pill">
      <span>🕊️</span>
      <span>Serenidad &amp; Enfoque • Beca 18</span>
    </div>
    <h1 class="musica-hero-title">Música para el Alma y la Concentración</h1>
    <p class="musica-hero-phrase">
      «La paz de Dios guardará tu corazón y tu mente mientras estudias.» Dale play y deja que la música ordene tus pensamientos, Clayda.
    </p>
  </section>

  <!-- 2. SINCRONIZACIÓN DE AUDIO CON EL SIMULADOR DE EXAMEN -->
  <section class="musica-sync-card" aria-label="Música continua en simulador">
    <div class="musica-sync-left">
      <div class="musica-sync-icon">
        <i class="fa-solid fa-music"></i>
      </div>
      <div class="musica-sync-text">
        <span class="musica-sync-title">Música de fondo en Simulador</span>
        <span class="musica-sync-desc" id="syncDescText">Activado • Continuará sonando en tu examen</span>
      </div>
    </div>
    <button type="button" class="musica-sync-toggle" id="btnSyncToggle" aria-label="Alternar música de fondo en simulador">
      <span class="musica-sync-knob"></span>
    </button>
  </section>

  <!-- 3. REPRODUCTOR MAESTRO DE ALTA FIDELIDAD -->
  <section class="musica-player-card" aria-label="Reproductor principal">
    <!-- Portada con imagen zen de estudio -->
    <div class="musica-cover-wrap">
      <img 
        src="diosesamor.png"
        alt="Santuario de estudio de Clayda con biblia, cuadernos y café" 
        class="musica-cover-img"
        id="playerCoverImg"
      />
      <div class="musica-cover-overlay"></div>
      
      <div class="musica-live-badge">
        <span class="musica-pulse-dot"></span>
        <span>STREAMING DE PAZ</span>
      </div>

      <div class="musica-cover-footer">
        <div>
          <p class="musica-cover-sub">Frecuencia de Reposo</p>
          <p class="musica-cover-title">Calma Interior &amp; Claridad Mental</p>
        </div>
        <i class="fa-solid fa-wand-magic-sparkles"></i>
      </div>
    </div>

    <!-- Título y detalles de la pista actual -->
    <div class="musica-track-head">
      <div class="musica-track-info">
        <h2 class="musica-track-current-title" id="trackCurrentTitle">Around The World (Slowed &amp; Reverb)</h2>
        <p class="musica-track-current-artist" id="trackCurrentArtist">ATC | Wesker Edit</p>
      </div>
      <button type="button" class="musica-fav-btn" id="btnFav" aria-label="Guardar en favoritos">
        <i class="fa-solid fa-heart"></i>
      </button>
    </div>

    <!-- Ecualizador de ondas animado -->
    <div class="musica-waveform" id="waveform">
      <span class="musica-wave-bar"></span>
      <span class="musica-wave-bar"></span>
      <span class="musica-wave-bar"></span>
      <span class="musica-wave-bar"></span>
      <span class="musica-wave-bar"></span>
      <span class="musica-wave-bar"></span>
      <span class="musica-wave-bar"></span>
      <span class="musica-wave-bar"></span>
      <span class="musica-wave-bar"></span>
      <span class="musica-wave-bar"></span>
      <span class="musica-wave-bar"></span>
      <span class="musica-wave-bar"></span>
      <span class="musica-wave-bar"></span>
      <span class="musica-wave-bar"></span>
      <span class="musica-wave-bar"></span>
      <span class="musica-wave-bar"></span>
      <span class="musica-wave-bar"></span>
      <span class="musica-wave-bar"></span>
    </div>

    <!-- Barra de progreso Scrubber interactiva -->
    <div class="musica-scrubber-wrap">
      <div class="musica-scrubber-track" id="scrubberTrack" role="progressbar" aria-valuenow="0" aria-valuemin="0" aria-valuemax="100">
        <div class="musica-scrubber-fill" id="scrubberFill"></div>
        <div class="musica-scrubber-knob" id="scrubberKnob"></div>
      </div>
      <div class="musica-time-row">
        <span id="currentTimeLabel">00:00</span>
        <span id="playerStatusLabel">Modo Serenidad</span>
        <span id="durationLabel">03:40</span>
      </div>
    </div>

    <!-- Controles Principales -->
    <div class="musica-controls-row">
      <button type="button" class="musica-ctrl-btn" id="btnShuffle" title="Modo aleatorio" aria-label="Modo aleatorio">
        <i class="fa-solid fa-shuffle"></i>
      </button>

      <button type="button" class="musica-ctrl-btn" id="btnPrevTrack" title="Pista anterior" aria-label="Pista anterior">
        <i class="fa-solid fa-backward-step"></i>
      </button>

      <button type="button" class="musica-play-pill" id="btnMainPlay" aria-label="Reproducir o pausar">
        <i class="fa-solid fa-play" id="playIcon"></i>
      </button>

      <button type="button" class="musica-ctrl-btn" id="btnNextTrack" title="Siguiente pista" aria-label="Siguiente pista">
        <i class="fa-solid fa-forward-step"></i>
      </button>

      <button type="button" class="musica-ctrl-btn" id="btnRepeat" title="Repetir lista" aria-label="Repetir lista">
        <i class="fa-solid fa-repeat"></i>
      </button>
    </div>

    <!-- Temporizador de Estudio / Pomodoro -->
    <div class="musica-timer-wrap">
      <div class="musica-timer-head">
        <span class="musica-timer-label">
          <i class="fa-solid fa-stopwatch" style="color: var(--warning);"></i>
          <span>Temporizador de Estudio</span>
        </span>
        <span class="musica-timer-status" id="timerStatusLabel">Sin límite</span>
      </div>
      <div class="musica-timer-pills-row" id="timerPillsRow">
        <button type="button" class="musica-timer-pill" data-min="15">15m</button>
        <button type="button" class="musica-timer-pill" data-min="30">30m</button>
        <button type="button" class="musica-timer-pill" data-min="45">45m Pomodoro</button>
        <button type="button" class="musica-timer-pill" data-min="120">120m Simulacro</button>
        <button type="button" class="musica-timer-pill selected" data-min="0">Sin límite</button>
      </div>
    </div>
  </section>

  <!-- 4. LISTA DE PISTAS DE CLAYDA (22 CANCIONES DE PAZ Y DIOS) -->
  <section class="musica-tracklist-section" aria-label="Lista de pistas de Clayda">
    <div class="musica-tracklist-head">
      <h2 class="musica-tracklist-title">Canciones para Clayda</h2>
      <span class="musica-tracklist-count">{playlistData.length} pistas de paz</span>
    </div>

    <div class="musica-tracklist-items" id="tracklistItems">
      {playlistData.map((item, index) => (
        <article 
          class={`musica-track-item ${index === 0 ? 'active' : ''}`}
          data-track-index={index}
          data-track-id={item.id}
        >
          <div class="musica-track-left">
            <div class="musica-track-icon-box">
              <i class={`fa-solid ${item.icono || 'fa-music'}`}></i>
            </div>
            <div class="musica-track-meta">
              <span class="musica-track-name">{item.titulo}</span>
              <span class="musica-track-sub">{item.artista} • {item.duracion}</span>
            </div>
          </div>
          <button type="button" class="musica-track-action-btn" aria-label={`Reproducir ${item.titulo}`}>
            <i class="fa-solid fa-play"></i>
          </button>
        </article>
      ))}
    </div>
  </section>

  <!-- 5. MEZCLADOR DE SONIDOS AMBIENTALES PROCEDURALES (WEB AUDIO API) -->
  <section class="musica-soundscapes-section" aria-label="Sonidos ambientales">
    <div class="musica-soundscapes-head">
      <div>
        <h2 class="musica-soundscapes-title">Sonidos Ambientales</h2>
        <p class="musica-soundscapes-sub">Combina capas de calma junto a tu música (100% offline)</p>
      </div>
      <button type="button" class="musica-btn-reset-ambients" id="btnResetAmbients">
        Silenciar todos
      </button>
    </div>

    <div class="musica-soundscapes-grid">
      <!-- Lluvia Suave -->
      <div class="musica-soundscape-card" data-ambient="lluvia">
        <div class="musica-soundscape-top">
          <div class="musica-soundscape-title-wrap">
            <span>🌧️</span>
            <span>Lluvia Suave</span>
          </div>
          <button type="button" class="musica-soundscape-toggle" data-action="toggle" aria-label="Alternar lluvia">
            <i class="fa-solid fa-volume-xmark"></i>
          </button>
        </div>
        <input 
          type="range" 
          class="musica-soundscape-slider" 
          min="0" 
          max="100" 
          value="40" 
          aria-label="Volumen lluvia suave"
        />
        <span class="musica-soundscape-val">40% volumen</span>
      </div>

      <!-- Café Calmo -->
      <div class="musica-soundscape-card" data-ambient="cafe">
        <div class="musica-soundscape-top">
          <div class="musica-soundscape-title-wrap">
            <span>☕</span>
            <span>Café Calmo</span>
          </div>
          <button type="button" class="musica-soundscape-toggle" data-action="toggle" aria-label="Alternar café">
            <i class="fa-solid fa-volume-xmark"></i>
          </button>
        </div>
        <input 
          type="range" 
          class="musica-soundscape-slider" 
          min="0" 
          max="100" 
          value="30" 
          aria-label="Volumen café calmo"
        />
        <span class="musica-soundscape-val">Silenciado</span>
      </div>

      <!-- Brisa & Aves -->
      <div class="musica-soundscape-card" data-ambient="brisa">
        <div class="musica-soundscape-top">
          <div class="musica-soundscape-title-wrap">
            <span>🍃</span>
            <span>Brisa Serrana</span>
          </div>
          <button type="button" class="musica-soundscape-toggle" data-action="toggle" aria-label="Alternar brisa">
            <i class="fa-solid fa-volume-xmark"></i>
          </button>
        </div>
        <input 
          type="range" 
          class="musica-soundscape-slider" 
          min="0" 
          max="100" 
          value="35" 
          aria-label="Volumen brisa"
        />
        <span class="musica-soundscape-val">Silenciado</span>
      </div>

      <!-- Olas Suaves -->
      <div class="musica-soundscape-card" data-ambient="olas">
        <div class="musica-soundscape-top">
          <div class="musica-soundscape-title-wrap">
            <span>🌊</span>
            <span>Olas de Paz</span>
          </div>
          <button type="button" class="musica-soundscape-toggle" data-action="toggle" aria-label="Alternar olas">
            <i class="fa-solid fa-volume-xmark"></i>
          </button>
        </div>
        <input 
          type="range" 
          class="musica-soundscape-slider" 
          min="0" 
          max="100" 
          value="45" 
          aria-label="Volumen olas"
        />
        <span class="musica-soundscape-val">Silenciado</span>
      </div>
    </div>
  </section>

  <!-- 6. CONSEJO FRATERNAL DE FE Y FUERZA AL FINAL -->
  <section class="musica-fraternal-card" aria-label="Consejo fraternal de fe">
    <div class="musica-fraternal-icon-box">
      <i class="fa-solid fa-heart"></i>
    </div>
    <div class="musica-fraternal-content">
      <span class="musica-fraternal-title">Consejo Fraternal de Fe y Fuerza</span>
      <p class="musica-fraternal-desc">
        «Ponte tus audífonos, respira hondo 3 veces y recuerda que Dios está a tu lado en cada fórmula matemática y en cada párrafo. Tu esfuerzo ya está bendecido. ¡Vamos juntas por esos 120 puntos, Clayda!»
      </p>
    </div>
  </section>
</div>

<!-- SCRIPTS DE DATOS Y MOTOR DE REPRODUCCIÓN -->
<script is:inline id="playlistDataJson" type="application/json" set:html={playlistJson}></script>

<script>
  import { audioManager } from './lib/audioManager.js';
  import { soundscapes } from './lib/soundscapes.js';

  function initMusicaPage() {
    const musicaRoot = document.getElementById('musicaRoot');
    if (!musicaRoot) return;

    // Elementos DOM del reproductor
    const btnMainPlay = document.getElementById('btnMainPlay');
    const playIcon = document.getElementById('playIcon');
    const btnPrevTrack = document.getElementById('btnPrevTrack');
    const btnNextTrack = document.getElementById('btnNextTrack');
    const btnShuffle = document.getElementById('btnShuffle');
    const btnRepeat = document.getElementById('btnRepeat');
    const btnFav = document.getElementById('btnFav');
    const waveform = document.getElementById('waveform');

    const trackCurrentTitle = document.getElementById('trackCurrentTitle');
    const trackCurrentArtist = document.getElementById('trackCurrentArtist');
    const currentTimeLabel = document.getElementById('currentTimeLabel');
    const durationLabel = document.getElementById('durationLabel');
    const scrubberTrack = document.getElementById('scrubberTrack');
    const scrubberFill = document.getElementById('scrubberFill');

    const trackItems = document.querySelectorAll('.musica-track-item');
    const timerPills = document.querySelectorAll('.musica-timer-pill');
    const timerStatusLabel = document.getElementById('timerStatusLabel');

    const btnSyncToggle = document.getElementById('btnSyncToggle');
    const syncDescText = document.getElementById('syncDescText');

    function formatearSegundos(seg) {
      const s = Math.max(0, Math.floor(seg));
      const m = Math.floor(s / 60);
      const r = s % 60;
      return `${String(m).padStart(2, '0')}:${String(r).padStart(2, '0')}`;
    }

    // Actualiza la UI completa según el estado del audioManager
    function sincronizarUIConEstado(estado) {
      if (!estado) estado = audioManager.getEstado();
      const pista = estado.pista;

      if (pista) {
        if (trackCurrentTitle) trackCurrentTitle.textContent = pista.titulo;
        if (trackCurrentArtist) trackCurrentArtist.textContent = pista.artista;
        if (durationLabel && pista.duracion) durationLabel.textContent = pista.duracion;
      }

      if (playIcon) {
        playIcon.className = estado.isPlaying ? 'fa-solid fa-pause' : 'fa-solid fa-play';
      }
      if (waveform) {
        waveform.classList.toggle('playing', estado.isPlaying);
      }

      if (btnShuffle) {
        btnShuffle.classList.toggle('active', estado.isShuffle);
      }
      if (btnRepeat) {
        btnRepeat.classList.toggle('active', estado.isRepeat);
      }

      if (btnSyncToggle) {
        btnSyncToggle.classList.toggle('off', !estado.bgAudioEnabled);
        if (syncDescText) {
          syncDescText.textContent = estado.bgAudioEnabled 
            ? 'Activado • Continuará sonando en tu examen'
            : 'Desactivado • Se pausará en el examen';
        }
      }

      trackItems.forEach((item, idx) => {
        const icon = item.querySelector('.musica-track-action-btn i');
        if (idx === estado.indice) {
          item.classList.add('active');
          if (icon) icon.className = estado.isPlaying ? 'fa-solid fa-pause' : 'fa-solid fa-play';
        } else {
          item.classList.remove('active');
          if (icon) icon.className = 'fa-solid fa-play';
        }
      });
    }

    // Suscribirse a eventos de audioManager
    audioManager.suscribir((evento, datos, estado) => {
      if (!document.getElementById('musicaRoot')) return;

      if (evento === 'timeUpdate') {
        if (currentTimeLabel) currentTimeLabel.textContent = formatearSegundos(datos.currentTime);
        if (durationLabel && !isNaN(datos.duration) && datos.duration > 0) {
          durationLabel.textContent = formatearSegundos(datos.duration);
        }
        if (scrubberFill) scrubberFill.style.width = `${datos.progressPct}%`;
      } else {
        sincronizarUIConEstado(estado);
      }
    });

    // Controles
    if (btnMainPlay) {
      btnMainPlay.onclick = () => audioManager.togglePlay();
    }
    if (btnNextTrack) {
      btnNextTrack.onclick = () => audioManager.siguiente();
    }
    if (btnPrevTrack) {
      btnPrevTrack.onclick = () => audioManager.anterior();
    }
    if (btnShuffle) {
      btnShuffle.onclick = () => audioManager.toggleShuffle();
    }
    if (btnRepeat) {
      btnRepeat.onclick = () => audioManager.toggleRepeat();
    }
    if (btnSyncToggle) {
      btnSyncToggle.onclick = () => audioManager.toggleBgSync();
    }

    if (btnFav) {
      btnFav.onclick = () => btnFav.classList.toggle('active');
    }

    // Scrubber click interactivo
    if (scrubberTrack) {
      scrubberTrack.onclick = (e) => {
        const dur = audioManager.getEstado().duration;
        if (!dur) return;
        const rect = scrubberTrack.getBoundingClientRect();
        const pos = Math.max(0, Math.min(1, (e.clientX - rect.left) / rect.width));
        audioManager.seek(pos * dur);
      };
    }

    // Click en pistas de la lista
    trackItems.forEach((item, index) => {
      item.onclick = () => {
        if (audioManager.currentIndex === index) {
          audioManager.togglePlay();
        } else {
          audioManager.cargarPista(index, true);
        }
      };
    });

    // Temporizador de Estudio (Sleep Timer)
    timerPills.forEach((pill) => {
      pill.onclick = () => {
        timerPills.forEach(p => p.classList.remove('selected'));
        pill.classList.add('selected');

        const mins = parseInt(pill.dataset.min, 10);
        if (mins > 0) {
          if (timerStatusLabel) timerStatusLabel.textContent = `${mins} min activo`;
          audioManager.setSleepTimer(mins, () => {
            if (timerStatusLabel) timerStatusLabel.textContent = 'Pausado por temporizador';
          });
        } else {
          audioManager.setSleepTimer(0);
          if (timerStatusLabel) timerStatusLabel.textContent = 'Sin límite';
        }
      };
    });

    // Sonidos Ambientales (Web Audio API)
    const soundscapeCards = document.querySelectorAll('.musica-soundscape-card');
    const btnResetAmbients = document.getElementById('btnResetAmbients');

    soundscapeCards.forEach((card) => {
      const ambientType = card.dataset.ambient;
      const toggleBtn = card.querySelector('[data-action="toggle"]');
      const slider = card.querySelector('.musica-soundscape-slider');
      const valText = card.querySelector('.musica-soundscape-val');

      if (toggleBtn) {
        toggleBtn.onclick = () => {
          const isNowActive = soundscapes.toggle(ambientType);
          card.classList.toggle('active', isNowActive);
          const icon = toggleBtn.querySelector('i');
          if (icon) {
            icon.className = isNowActive ? 'fa-solid fa-volume-high' : 'fa-solid fa-volume-xmark';
          }
          if (valText && slider) {
            valText.textContent = isNowActive ? `${slider.value}% volumen` : 'Silenciado';
          }
        };
      }

      if (slider) {
        slider.oninput = (e) => {
          const val = parseInt(e.target.value, 10);
          soundscapes.setVolume(ambientType, val / 100);
          if (valText && card.classList.contains('active')) {
            valText.textContent = `${val}% volumen`;
          }
        };
      }
    });

    if (btnResetAmbients) {
      btnResetAmbients.onclick = () => {
        soundscapes.stopAll();
        soundscapeCards.forEach((card) => {
          card.classList.remove('active');
          const icon = card.querySelector('[data-action="toggle"] i');
          if (icon) icon.className = 'fa-solid fa-volume-xmark';
          const valText = card.querySelector('.musica-soundscape-val');
          if (valText) valText.textContent = 'Silenciado';
        });
      };
    }

    // Sincronización inicial
    sincronizarUIConEstado(audioManager.getEstado());
  }

  document.addEventListener('astro:page-load', initMusicaPage);
</script>
